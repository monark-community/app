{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "test:integration:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
