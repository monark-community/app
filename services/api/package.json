{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "start:prod": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage --passWithNoTests"
  },
  "dependencies": {
    "@monark/api-keys": "workspace:*",
    "@monark/auth": "workspace:*",
    "@monark/automation": "workspace:*",
    "@monark/calendar": "workspace:*",
    "@monark/chat": "workspace:*",
    "@monark/common": "workspace:*",
    "@monark/data-models": "workspace:*",
    "@monark/db": "workspace:*",
    "@monark/discord": "workspace:*",
    "@monark/feature-flags": "workspace:*",
    "@monark/files": "workspace:*",
    "@monark/github": "workspace:*",
    "@monark/kanban": "workspace:*",
    "@monark/notifications": "workspace:*",
    "@monark/organizations": "workspace:*",
    "@monark/public-api": "workspace:*",
    "@monark/rbac": "workspace:*",
    "@monark/secrets": "workspace:*",
    "@monark/telegram": "workspace:*",
    "@monark/twitter": "workspace:*",
    "@monark/users": "workspace:*",
    "@monark/webhooks": "workspace:*",
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.105.3",
    "@trpc/server": "^11.18.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monark/mcp": "workspace:*",
    "@monark/test-utils": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
