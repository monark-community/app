{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "start:prod": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage --passWithNoTests"
  },
  "dependencies": {
    "@monark/auth": "workspace:*",
    "@monark/common": "workspace:*",
    "@monark/db": "workspace:*",
    "@monark/feature-flags": "workspace:*",
    "@monark/notifications": "workspace:*",
    "@monark/organizations": "workspace:*",
    "@monark/rbac": "workspace:*",
    "@monark/users": "workspace:*",
    "@monark/webhooks": "workspace:*",
    "@supabase/supabase-js": "^2.105.3",
    "@trpc/server": "^11.0.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@monark/test-utils": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
