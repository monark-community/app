PORT=4000
NODE_ENV=development
# CORS allowlist (comma-separated). In `NODE_ENV=development` the api
# also accepts any RFC 1918 / loopback origin so a phone hitting the
# web app over the LAN can call this api at the dev machine ; see
# services/api/src/server.ts.
WEB_ORIGIN=http://localhost:3000
# Origin of the web app; used when we need to build user-facing URLs
# (e.g. the link in confirmation emails). The web layer overrides this
# per-request via the request Host header so emails sent during a
# LAN-from-phone session land on the same host the user is on (see
# services/web/src/lib/request-app-url.ts) ; this value is the
# fallback when no per-request Host is available (cron jobs, scripts).
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase Postgres (filled in per-environment; leave blank for local-only).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth; server-side admin operations use the secret key. The
# publishable key is needed by the api too because the signup flow creates
# the auth user via the public client (non-cookie-setting) path.
# `pnpm supabase status` prints the local values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AES-256-GCM key for encrypting TOTP secrets at rest. 32 bytes, hex-encoded
# (64 chars). Generate locally with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotate via a migration that re-encrypts all existing TotpSecret rows.
TOTP_ENCRYPTION_KEY=

# AES-256-GCM key for the org-secrets store (@monark/secrets), encrypting
# external access tokens at rest. 32 bytes, hex-encoded (64 chars). Separate
# from TOTP's key so their blast radius stays independent. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# Singleton-org bootstrap. When zero organizations exist, the API
# server reads these at boot and provisions the singleton organization
# the rest of the app needs. Idempotent ; a restart on a healthy
# install is a no-op. You can also provision manually (without an API
# restart) via `pnpm provision:org` — see tools/provision-org.ts.
INITIAL_ORG_SLUG=acme
INITIAL_ORG_NAME=Acme Corporation
# Optional brand color. Hex, #RGB or #RRGGBB. QUOTE IT : Node's
# `--env-file` parser treats a leading `#` as a comment, so an unquoted
# `=#2563EB` resolves to an empty string.
INITIAL_ORG_PRIMARY_COLOR="#2563EB"

# Shared bearer secret required by the `/cron/*` endpoints (currently the
# daily 14-day grace-period sweep at /cron/process-account-deletions).
# Any HTTP scheduler can trigger them : Vercel Cron, GitHub Actions, an
# in-cluster k8s CronJob, EasyCron, etc. — they just need to send
# `Authorization: Bearer $CRON_SECRET`. The endpoints are idempotent so
# overlap or retries are safe. Generate locally with :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Manual dev trigger :
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#        http://localhost:4000/cron/process-account-deletions
CRON_SECRET=

# Outbound mail (new-device alerts, password-changed, deletion-grace,
# etc.). `supabase start` ships an Inbucket SMTP listener on port 54325
# (the 54324 you see in the dashboard is Inbucket's *web UI* — browse
# caught mail there). Production swaps in an SMTP URL from your
# transactional provider (Resend, Postmark, etc.). Leave SMTP_URL unset
# to log instead of send (useful for ephemeral CI).
SMTP_URL=smtp://localhost:54325
SMTP_FROM=App <noreply@example.com>

# ── Branding (white-label) ──────────────────────────────────────────
# The app ships with generic placeholder branding (@monark/branding). Set
# these to your product's identity ; each is optional and falls back to the
# generic default when unset. The web side needs the NEXT_PUBLIC_ duplicates
# in services/web/.env so the browser bundle picks them up. Full guide:
# docs/technical-documentation/white-label.md
BRANDING_APP_NAME=
BRANDING_TAGLINE=
BRANDING_SUPPORT_EMAIL=
BRANDING_TOTP_ISSUER=
BRANDING_FROM_EMAIL=
# Hex colours must be quoted for the same reason as
# INITIAL_ORG_PRIMARY_COLOR above, e.g. BRANDING_PRIMARY="#2563EB".
BRANDING_PRIMARY=
BRANDING_ACCENT=
BRANDING_LOGO_SRC=

# ── Error tracking (Sentry, optional) ───────────────────────────────
# Set SENTRY_DSN to turn on server-side error reporting ; leave it unset for a
# complete no-op (local dev, or any deploy that hasn't opted in). Traces are
# off by default (sample rate 0). Full guide:
# docs/technical-documentation/observability.md
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
