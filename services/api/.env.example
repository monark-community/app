PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
# Origin of the web app; used when we need to build user-facing URLs
# (e.g. the link in confirmation emails).
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase Postgres (filled in per-environment; leave blank for local-only).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth; server-side admin operations use the secret key. The
# publishable key is needed by the api too because the signup flow creates
# the auth user via the public client (non-cookie-setting) path.
# `pnpm supabase status` prints the local values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AES-256-GCM key for encrypting TOTP secrets at rest. 32 bytes, hex-encoded
# (64 chars). Generate locally with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotate via a migration that re-encrypts all existing TotpSecret rows.
TOTP_ENCRYPTION_KEY=

# Outbound mail (new-device alerts, future transactional). Mailpit on default
# `supabase start` listens on smtp://localhost:1025 with no auth. Production
# uses an SMTP URL from your transactional provider (Resend, Postmark, etc.).
# Leave SMTP_URL unset to log instead of send (useful for ephemeral CI).
SMTP_URL=
SMTP_FROM=Monark <noreply@monark.io>
