PORT=4000
NODE_ENV=development
# CORS allowlist (comma-separated). In `NODE_ENV=development` the api
# also accepts any RFC 1918 / loopback origin so a phone hitting the
# web app over the LAN can call this api at the dev machine ; see
# services/api/src/server.ts.
WEB_ORIGIN=http://localhost:3000
# Origin of the web app; used when we need to build user-facing URLs
# (e.g. the link in confirmation emails). The web layer overrides this
# per-request via the request Host header so emails sent during a
# LAN-from-phone session land on the same host the user is on (see
# services/web/src/lib/request-app-url.ts) ; this value is the
# fallback when no per-request Host is available (cron jobs, scripts).
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Supabase Postgres (filled in per-environment; leave blank for local-only).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth; server-side admin operations use the secret key. The
# publishable key is needed by the api too because the signup flow creates
# the auth user via the public client (non-cookie-setting) path.
# `pnpm supabase status` prints the local values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AES-256-GCM key for encrypting TOTP secrets at rest. 32 bytes, hex-encoded
# (64 chars). Generate locally with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Rotate via a migration that re-encrypts all existing TotpSecret rows.
TOTP_ENCRYPTION_KEY=

# Single-tenant bootstrap. When the `tenancy.multi-tenant` feature flag
# is OFF (default) and zero organizations exist, the API server reads
# these at boot and provisions the singleton organization the rest of
# the app needs. Idempotent ; a restart on a healthy install is a no-op.
# /setup is the user-facing surface that displays the boot status and
# documents this contract for whichever external tool sets these vars.
# Multi-tenant deploys can leave them unset.
INITIAL_ORG_SLUG=acme
INITIAL_ORG_NAME=Acme Corporation
# Optional brand color. Hex, #RGB or #RRGGBB.
INITIAL_ORG_PRIMARY_COLOR=#F0870C

# Shared bearer secret required by the `/cron/*` endpoints (currently the
# daily 14-day grace-period sweep at /cron/process-account-deletions).
# Any HTTP scheduler can trigger them : Vercel Cron, GitHub Actions, an
# in-cluster k8s CronJob, EasyCron, etc. — they just need to send
# `Authorization: Bearer $CRON_SECRET`. The endpoints are idempotent so
# overlap or retries are safe. Generate locally with :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Manual dev trigger :
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#        http://localhost:4000/cron/process-account-deletions
CRON_SECRET=

# Outbound mail (new-device alerts, password-changed, deletion-grace,
# etc.). `supabase start` ships an Inbucket SMTP listener on port 54325
# (the 54324 you see in the dashboard is Inbucket's *web UI* — browse
# caught mail there). Production swaps in an SMTP URL from your
# transactional provider (Resend, Postmark, etc.). Leave SMTP_URL unset
# to log instead of send (useful for ephemeral CI).
SMTP_URL=smtp://localhost:54325
SMTP_FROM=Monark <noreply@monark.io>
