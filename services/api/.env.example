PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Supabase Postgres (filled in per-environment; leave blank for local-only).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth; server-side admin operations use the secret key.
# `pnpm supabase status` prints the local values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
