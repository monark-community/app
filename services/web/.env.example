NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase Auth; browser-side uses the publishable key.
# `pnpm supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never NEXT_PUBLIC_*); used by server actions that need admin access.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=

# ── Branding (white-label) ──────────────────────────────────────────
# Browser-visible product identity ; mirror the server-side BRANDING_* vars
# (services/api/.env) so the app bar, page titles, and NProgress color match.
# Each is optional and falls back to the generic default. Full guide:
# docs/technical-documentation/white-label.md
NEXT_PUBLIC_BRANDING_APP_NAME=
NEXT_PUBLIC_BRANDING_TAGLINE=
NEXT_PUBLIC_BRANDING_SUPPORT_EMAIL=
NEXT_PUBLIC_BRANDING_PRIMARY=
NEXT_PUBLIC_BRANDING_ACCENT=
NEXT_PUBLIC_BRANDING_LOGO_SRC=

# LAN-from-phone testing : leave the URLs above pointing at localhost.
# When the app is opened from a non-loopback host (e.g. http://10.0.0.42:3000
# from your phone), the browser-side tRPC client + Supabase client
# auto-rewrite the hostname to whatever the browser is on
# (`src/lib/dev-host-rewrite.ts`), so the phone hits your dev machine
# instead of its own loopback. Email-link redirects also follow the
# request Host header (`src/lib/request-app-url.ts`). The api server's
# CORS check allows any RFC 1918 origin in dev, and Supabase's
# `additional_redirect_urls` allowlist already covers `10.*`, `192.168.*`,
# and the `172.16.*`-`172.31.*` private ranges. No env edits needed —
# make sure the phone is on the same Wi-Fi as the dev PC and that your
# firewall allows ports 3000, 4000, and 54321.
