    "node-ical": "^0.27.1",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@monark/test-utils": "workspace:*",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^3.2.7",
