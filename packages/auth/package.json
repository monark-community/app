    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.9",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@monark/test-utils": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
