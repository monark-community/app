{
  "name": "@monark/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./events": {
      "types": "./src/events.ts",
      "default": "./src/events.ts"
    },
    "./contracts/events": {
      "types": "./src/contracts/events.ts",
      "default": "./src/contracts/events.ts"
    },
    "./trpc": {
      "types": "./src/trpc.ts",
      "default": "./src/trpc.ts"
    },
    "./pagination": {
      "types": "./src/pagination.ts",
      "default": "./src/pagination.ts"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./src/crypto.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "default": "./src/http.ts"
    },
    "./rate-limit": {
      "types": "./src/rate-limit.ts",
      "default": "./src/rate-limit.ts"
    },
    "./blocks": {
      "types": "./src/blocks.ts",
      "default": "./src/blocks.ts"
    },
    "./color": {
      "types": "./src/color.ts",
      "default": "./src/color.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@monark/db": "workspace:*",
    "@trpc/server": "^11.18.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^4.1.11"
  }
}
