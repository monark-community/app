{
  "name": "@monark/api-keys",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage --passWithNoTests"
  },
  "dependencies": {
    "@monark/common": "workspace:*",
    "@monark/db": "workspace:*",
    "@monark/feature-flags": "workspace:*",
    "@monark/organizations": "workspace:*",
    "@monark/rbac": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@monark/test-utils": "workspace:*",
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.0.0"
  }
}
