{
  "name": "monark-app",
  "version": "0.0.0",
  "private": true,
  "description": "Monark App monorepo root.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "tsx tools/bootstrap.ts",
    "prepare": "simple-git-hooks",
    "dev": "turbo run dev",
    "dev:tools": "tsx tools/open-tool.ts",
    "dev:tools:mail": "tsx tools/open-tool.ts mail",
    "dev:tools:supabase": "tsx tools/open-tool.ts supabase",
    "dev:tools:db": "tsx tools/open-tool.ts db",
    "dev:tools:all": "tsx tools/open-tool.ts all",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:integration:coverage": "turbo run test:integration:coverage --concurrency=1",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter @monark/db db:migrate",
    "db:reset": "pnpm --filter @monark/db db:reset",
    "check:tiers": "tsx tools/check-tiers.ts",
    "check:modules": "tsx tools/check-modules.ts",
    "check:i18n": "tsx tools/check-i18n.ts",
    "check:migrations": "tsx tools/check-migrations.ts",
    "check:mcp": "tsx tools/check-public-api-mcp.ts",
    "coverage:merge": "tsx tools/merge-coverage.ts",
    "gen": "pnpm gen:schema && pnpm gen:events && pnpm gen:routers",
    "gen:module": "tsx tools/gen-module.ts",
    "gen:schema": "tsx tools/gen-schema.ts",
    "gen:events": "tsx tools/gen-events.ts",
    "gen:routers": "tsx tools/gen-routers.ts",
    "prebuild": "pnpm gen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sysadmin": "tsx --env-file=services/api/.env tools/sysadmin.ts",
    "enable:dev-flags": "tsx --env-file=services/api/.env tools/enable-dev-flags.ts",
    "webhook-receiver": "tsx tools/webhook-receiver.ts"
  },
  "dependencies": {
    "@monark/auth": "workspace:*",
    "@monark/chat": "workspace:*",
    "@monark/data-models": "workspace:*",
    "@monark/db": "workspace:*",
    "@monark/feature-flags": "workspace:*",
    "@monark/organizations": "workspace:*",
    "@monark/public-api": "workspace:*",
    "@monark/rbac": "workspace:*"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.0",
    "simple-git-hooks": "^2.13.0",
    "supabase": "^2.95.4",
    "tsx": "^4.21.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<=8.5.17": "8.5.18",
      "js-yaml@>=4.0.0 <4.3.0": "4.3.0",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "protobufjs@>=7.5.0 <=7.6.4": "7.6.5",
      "sharp@<0.35.0": "^0.35.0",
      "next-intl@<=4.9.1": ">=4.9.2",
      "icu-minify@<=4.9.1": ">=4.9.2",
      "uuid@<11.1.1": "^11.1.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "undici@<6.27.0": "^6.27.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "tar@<=7.5.20": ">=7.5.21",
      "nodemailer@<=9.0.0": ">=9.0.1",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "ua-parser-js@>=2.0.1 <2.0.10": ">=2.0.10",
      "@grpc/grpc-js@>=1.14.0 <1.14.4": ">=1.14.4",
      "vite@>=7.0.0 <=7.3.4": "^7.3.5",
      "vitest@<3.2.6": "^3.2.6",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "tmp@<0.2.6": ">=0.2.6",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "brace-expansion@<1.1.17": "1.1.17",
      "brace-expansion@>=2.0.0 <2.1.3": "2.1.3",
      "brace-expansion@>=4.0.0 <5.0.8": "5.0.9",
      "typescript": "5.9.3"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm lint"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{js,mjs,cjs,json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
