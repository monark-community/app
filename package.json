{
  "name": "monark-app",
  "version": "0.0.0",
  "private": true,
  "description": "Monark App monorepo root.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "tsx tools/bootstrap.ts",
    "prepare": "simple-git-hooks",
    "dev": "turbo run dev",
    "dev:tools": "tsx tools/open-tool.ts",
    "dev:tools:mail": "tsx tools/open-tool.ts mail",
    "dev:tools:supabase": "tsx tools/open-tool.ts supabase",
    "dev:tools:db": "tsx tools/open-tool.ts db",
    "dev:tools:all": "tsx tools/open-tool.ts all",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "test:integration:coverage": "turbo run test:integration:coverage",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:migrate": "pnpm --filter @monark/db db:migrate",
    "db:reset": "pnpm --filter @monark/db db:reset",
    "check:tiers": "tsx tools/check-tiers.ts",
    "coverage:merge": "tsx tools/merge-coverage.ts",
    "gen": "pnpm gen:events && pnpm gen:routers",
    "gen:module": "tsx tools/gen-module.ts",
    "gen:events": "tsx tools/gen-events.ts",
    "gen:routers": "tsx tools/gen-routers.ts",
    "prebuild": "pnpm gen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sysadmin": "tsx --env-file=services/api/.env tools/sysadmin.ts",
    "webhook-receiver": "tsx tools/webhook-receiver.ts"
  },
  "dependencies": {
    "@monark/auth": "workspace:*",
    "@monark/db": "workspace:*",
    "@monark/organizations": "workspace:*",
    "@monark/rbac": "workspace:*"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.0",
    "simple-git-hooks": "^2.13.0",
    "supabase": "^2.95.4",
    "tsx": "^4.21.0",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm lint"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{js,mjs,cjs,json,yaml,yml,md}": [
      "prettier --write"
    ]
  }
}
